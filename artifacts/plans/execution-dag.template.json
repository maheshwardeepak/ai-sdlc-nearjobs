{
  "mode": "new_project",
  "requiresHumanApprovalBeforeExecution": true,
  "nodes": [
    {
      "id": "intake",
      "agent": "intake-agent",
      "dependencies": [],
      "outputs": ["normalized-prd.md"]
    },
    {
      "id": "planning",
      "agent": "planning-agent",
      "dependencies": ["intake"],
      "outputs": ["project-plan.md", "architecture.md", "execution-dag.json"]
    },
    {
      "id": "human_approval",
      "agent": "planning-agent",
      "dependencies": ["planning"],
      "blocksExecution": true
    },
    {
      "id": "engineering",
      "agent": "engineering-agent",
      "dependencies": ["human_approval"],
      "parallelizable": true
    },
    {
      "id": "infra_deploy",
      "agent": "infra-deploy-agent",
      "dependencies": ["engineering"]
    },
    {
      "id": "validation",
      "agent": "validation-agent",
      "dependencies": ["infra_deploy"],
      "parallelizable": true
    },
    {
      "id": "debug_fix_if_needed",
      "agent": "debug-fix-agent",
      "dependencies": ["validation"],
      "conditional": "any_quality_gate_failed"
    },
    {
      "id": "review_qa",
      "agent": "review-qa-agent",
      "dependencies": ["validation"]
    },
    {
      "id": "delivery_memory",
      "agent": "delivery-memory-agent",
      "dependencies": ["review_qa"]
    }
  ]
}
